# Dependencies
node_modules/

# Environment files — real secrets live here, never in git.
# .env.example is intentionally NOT ignored: it documents required
# variable names with placeholder values.
.env
.env.local
.env.*.local

# Build output
dist/
# apps/server/public: the built frontend, copied in by the Docker build
# (or manually for local verification) — never a source directory.
apps/server/public/

# Test artifacts
coverage/
test-results/
playwright-report/

# Logs
*.log

# Editor & OS noise
.vscode/
.idea/
.DS_Store
