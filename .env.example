# Aqlis environment variables.
# Copy to apps/server/.env and fill in real values. NEVER commit .env.

# Neon Postgres — POOLED connection (hostname contains "-pooler").
# Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Neon Postgres — DIRECT connection (same string, no "-pooler").
# Used only by Prisma migrations / CLI tooling.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-example.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Upstash Redis — native protocol, TLS ("rediss://", double-s).
# The ingestion queue: price/fundamentals workers XADD here,
# consumers XREADGROUP from here.
REDIS_URL="rediss://default:PASSWORD@example-12345.upstash.io:6379"

# Finnhub — real-time price WebSocket.
# Free tier: US symbols only, max 50 subscribed symbols.
FINNHUB_API_KEY="your_finnhub_api_key"

# Financial Modeling Prep — quarterly fundamentals (REST).
# Free tier: 250 requests/day, US companies.
FMP_API_KEY="your_fmp_api_key"

# Seconds between fundamentals polls. Default 6h (21600). Each poll makes
# 2 requests per symbol (balance sheet + income statement).
FUNDAMENTALS_POLL_INTERVAL_SECONDS="21600"

# Watchlist: comma-separated US tickers to screen. PG and MO were
# dropped from the original 12 in Phase 7 — FMP's free tier premium-
# gates them (HTTP 402 on fundamentals) even though quotes work fine;
# verify a new symbol against FMP before adding it back.
WATCHLIST_SYMBOLS="AAPL,MSFT,NVDA,TSLA,XOM,JNJ,JPM,BAC,MGM,T"

# Seconds between price-stream flushes. Ticks are buffered in memory and
# one entry per symbol is written per window — keeps us inside Upstash's
# 500K commands/month free tier (see ADR-001).
PRICE_FLUSH_INTERVAL_SECONDS="30"
